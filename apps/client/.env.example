# Copy to .env.local and fill in.
VITE_API_URL=https://declyne-api.YOUR-SUBDOMAIN.workers.dev

# The API token is NOT a VITE_* variable: every VITE_* value is compiled into the
# public JS bundle. The app reads the token only from Keychain / secure storage,
# pasted once in Settings -> Token. The build fails if a VITE_*TOKEN is set.
# Local scripts (scripts/db-reseed.sh) read this one, which Vite never bundles:
DECLYNE_API_TOKEN=paste-the-same-value-you-used-for-wrangler-secret-put-API_TOKEN
